{
  "name": "lucy-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "LUCY's face: a Vue client for the LUCY hub with a programmable face, a streamed transcript and approval cards. A REX Technologies product.",
  "license": "MIT",
  "author": "Tochi Mba",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tochi-mba/LUCY-ui.git"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:fake": "node scripts/dev-fake.mjs",
    "fake-hub": "node scripts/fake-hub.mjs",
    "build": "vite build",
    "serve": "node scripts/serve.mjs",
    "headed": "node scripts/headed.mjs",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build && npm run check:site",
    "check:site": "node scripts/check-site.mjs site LUCY"
  },
  "dependencies": {
    "agent-robot-avatar": "~0.5.2",
    "markdown-it": "^14.1.0",
    "vue": "^3.5.43",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.64.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/coverage-v8": "^5.0.3",
    "@vue/test-utils": "^2.5.1",
    "happy-dom": "^20.14.6",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.12"
  }
}
